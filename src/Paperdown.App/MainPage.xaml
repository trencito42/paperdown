<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Paperdown_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            x:Name="FileCommandBar"
            DefaultLabelPosition="Right"
            IsOpen="False"
            Background="Transparent">
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open Markdown (Ctrl+O)" />
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" ToolTipService.ToolTip="Save (Ctrl+S)" />
            <AppBarButton
                x:Name="ExportPdfButton"
                Icon="SaveLocal"
                Label="Export PDF"
                ToolTipService.ToolTip="Export PDF (Ctrl+E)" />
            <AppBarSeparator />
            <AppBarElementContainer>
                <ComboBox
                    x:Name="ThemeComboBox"
                    MinWidth="140"
                    Header="Theme"
                    PlaceholderText="Theme"
                    ToolTipService.ToolTip="Document theme for preview and PDF" />
            </AppBarElementContainer>
            <AppBarButton x:Name="PageSettingsButton" Icon="Page" Label="Page" ToolTipService.ToolTip="Page size, orientation, and margins" />
            <AppBarButton x:Name="BrandingButton" Icon="Contact" Label="Branding" ToolTipService.ToolTip="Cover page, logo, and document identity" />
            <AppBarSeparator />
            <AppBarButton x:Name="ToggleEditorButton" Icon="Edit" Label="Hide editor" ToolTipService.ToolTip="Hide editor (Ctrl+E)" />
            <AppBarButton x:Name="WordWrapButton" Icon="WrapText" Label="Wrap" ToolTipService.ToolTip="Toggle word wrap" />
            <AppBarButton x:Name="ZoomOutButton" Icon="ZoomOut" Label="Zoom out" ToolTipService.ToolTip="Zoom preview out" />
            <AppBarElementContainer>
                <TextBlock
                    x:Name="ZoomLabel"
                    MinWidth="44"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    ToolTipService.ToolTip="Preview zoom level" />
            </AppBarElementContainer>
            <AppBarButton x:Name="ZoomInButton" Icon="ZoomIn" Label="Zoom in" ToolTipService.ToolTip="Zoom preview in" />
            <AppBarButton x:Name="FitWidthButton" Icon="FullScreen" Label="Fit width" ToolTipService.ToolTip="Fit preview width" />
            <AppBarButton x:Name="FitPageButton" Icon="Document" Label="Fit page" ToolTipService.ToolTip="Fit entire page in preview" />
            <AppBarButton x:Name="FindButton" Icon="Find" Label="Find" ToolTipService.ToolTip="Find and replace (Ctrl+F)" />
        </CommandBar>

        <InfoBar
            x:Name="PreviewInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Title="Preview unavailable"
            Message="">
            <InfoBar.ActionButton>
                <Button x:Name="PreviewInfoRetryButton" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" x:Name="EditorPreviewGrid" MinHeight="200">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="420" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="EditorPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LineNumberColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="LineNumberPanel"
                    Grid.Column="0"
                    Padding="8,12,6,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="LineNumberText"
                        FontFamily="Cascadia Mono, Consolas, Courier New"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="20"
                        Text="1" />
                </Border>
                <TextBox
                    x:Name="MarkdownEditor"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    BorderThickness="0"
                    FontFamily="Cascadia Mono, Consolas, Courier New"
                    FontSize="13"
                    Padding="12"
                    PlaceholderText="Write Markdown here…"
                    SelectionHighlightColorWhenNotFocused="{ThemeResource SystemFillColorAttentionBrush}"
                    TextWrapping="Wrap" />
            </Grid>

            <Border
                x:Name="SplitterBar"
                Grid.Column="1"
                Width="6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid x:Name="PreviewPanel" Grid.Column="2" Background="{ThemeResource LayerFillColorAltBrush}">
                <controls:WebView2 x:Name="PreviewWebView" DefaultBackgroundColor="Transparent" />
                <StackPanel
                    x:Name="PreviewFallbackPanel"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="440"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="PreviewFallbackTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Document preview" />
                    <TextBlock
                        x:Name="PreviewFallbackSummary"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviewFallbackRetryButton" Content="Retry" Style="{StaticResource AccentButtonStyle}" />
                        <HyperlinkButton
                            x:Name="PreviewRuntimeLink"
                            Content="Get WebView2 Runtime"
                            NavigateUri="https://go.microsoft.com/fwlink/p/?LinkId=2124703" />
                    </StackPanel>
                    <Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostics" />
                </StackPanel>
                <ProgressRing
                    x:Name="PreviewProgress"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="12,4"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ready" />
                <TextBlock
                    x:Name="WordCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="PageCountText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="UTF-8" />
            </Grid>
        </Border>
    </Grid>
</Page>
